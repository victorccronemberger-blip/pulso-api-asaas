HOST=0.0.0.0
PORT=3000
NODE_ENV=production
PUBLIC_ORIGIN=https://pulso.cyara.com.br
# Obtain all values below from the deployment secret manager; do not commit real values.
MYSQL_URL=
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Strong random token, 32-255 characters, also configured in the Asaas webhook.
ASAAS_WEBHOOK_TOKEN=
# Shared secret with the LMS frontend (pulso.cyara.com.br). Required header
# x-pulso-trusted-token on POST /v1/checkout/orders (server-to-server only).
TRUSTED_CHECKOUT_TOKEN=
