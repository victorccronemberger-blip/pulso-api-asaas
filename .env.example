HOST=0.0.0.0
PORT=3000
NODE_ENV=production
PUBLIC_ORIGIN=https://pulso.cyara.com.br
ADMIN_ORIGIN=https://pulso.cyara.com.br
# Obtain all values below from the deployment secret manager; do not commit real values.
MYSQL_URL=
ADMIN_BOOTSTRAP_TOKEN=generate-a-one-time-random-token
SESSION_PEPPER=generate-a-long-random-secret
ADMIN_SESSION_TTL_SECONDS=28800
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Strong random token, 32-255 characters, also configured in the Asaas webhook.
ASAAS_WEBHOOK_TOKEN=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=comercial@cyara.com.br
SMTP_PASSWORD=
EMAIL_FROM=comercial@cyara.com.br
# ---- Automatic course enrollment (ART platform) ----
# Master switch for the enrollment engine that fires when order access is granted.
ENROLLMENT_ENABLED=true
ART_API_BASE=https://api.academiarafaeltoro.com.br
ART_IDM_BASE=https://ms-idm.academiarafaeltoro.com.br
# Service accounts for REAL-TIME turma discovery (primary dynamic layer):
# "email:senha,email2:senha2". Each one logs in and lists /v1/services/turmas
# live — no hardcoded cohort needed. Use accounts nobody logs into interactively
# (a new login rotates the token and kills other sessions of the same account).
ART_SERVICE_ACCOUNTS=
ART_REQUEST_TIMEOUT_MS=30000
ART_POLL_TIMEOUT_MS=1800000
ART_POLL_INTERVAL_MS=10000
ART_PROVISION_TIMEOUT_MS=120000
ART_MAX_RETRIES=3
ART_RETRY_DELAY_MS=15000
# Set to 0 only if the ART origin keeps shipping an unverifiable certificate.
# Payment provider calls always keep full TLS verification regardless of this flag.
ART_TLS_REJECT_UNAUTHORIZED=1

# ---- Protected learning delivery (Bunny Stream + Storage) ----
# Compact option for managed runtimes with a small environment-variable limit.
# Keep its JSON value only in the hosting dashboard, never in Git.
BUNNY_LEARNING_CONFIG=
BUNNY_STREAM_LIBRARY_ID=719981
# Existing library token-auth key. Configure only in the hosting environment.
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_EMBED_ORIGIN=https://iframe.mediadelivery.net
BUNNY_PLAYBACK_TOKEN_TTL_SECONDS=300
BUNNY_STORAGE_ZONE=pulso-cpa-2026-materiais
# Existing storage-zone password. Configure only in the hosting environment.
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_API_ORIGIN=https://storage.bunnycdn.com
