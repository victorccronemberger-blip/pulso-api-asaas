HOST=0.0.0.0
PORT=3000
NODE_ENV=production
PUBLIC_ORIGIN=https://pulso.cyara.com.br
ADMIN_ORIGIN=https://pulso.cyara.com.br
# Obtain all values below from the deployment secret manager; do not commit real values.
MYSQL_URL=
ADMIN_BOOTSTRAP_TOKEN=generate-a-one-time-random-token
SESSION_PEPPER=generate-a-long-random-secret
ADMIN_SESSION_TTL_SECONDS=28800
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Strong random token, 32-255 characters, also configured in the Asaas webhook.
ASAAS_WEBHOOK_TOKEN=
